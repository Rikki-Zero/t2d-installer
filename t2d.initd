#!/bin/bash

### BEGIN INIT INFO
# Provides:          t2d
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start and stop the T2D service instances
# Description:       Manages T2D UDP over TCP tunnel service instances.
### END INIT INFO

# Source function library.
# Note: /etc/init.d/functions and /lib/lsb/init-functions provide useful functions
# for init.d scripts. We'll try to use them if available, but define our own
# fallbacks if not.
[ -f /etc/init.d/functions ] && . /etc/init.d/functions
[ -f /lib/lsb/init-functions ] && . /lib/lsb/init-functions

# Configuration
SERVICE_NAME="t2d"
INSTALL_PATH="/bin/t2d"
CONFIG_DIR="/etc/t2d"
PID_DIR="/var/run/t2d"
LOG_DIR="/var/log/t2d"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Log functions - use init.d functions if available, else custom
log_info() {
    if type log_daemon_msg &> /dev/null; then
        log_daemon_msg "${SERVICE_NAME}" "$1"
    else
        echo -e "${BLUE}[INFO]${NC} $1"
    fi
}

log_success() {
    if type log_end_msg &> /dev/null; then
        log_end_msg 0
    else
        echo -e "${GREEN}[SUCCESS]${NC} $1"
    fi
}

log_warning() {
    if type log_warning_msg &> /dev/null; then
        log_warning_msg "$1"
    else
        echo -e "${YELLOW}[WARNING]${NC} $1"
    fi
}

log_error() {
    if type log_end_msg &> /dev/null; then
        log_end_msg 1
    else
        echo -e "${RED}[ERROR]${NC} $1"
    fi
}

# Function to get the PID file path for a given instance
get_pid_file_path() {
    local instance="$1"
    echo "${PID_DIR}/${SERVICE_NAME}-${instance}.pid"
}

# Function to get the log file path for a given instance
get_log_file_path() {
    local instance="$1"
    echo "${LOG_DIR}/${SERVICE_NAME}-${instance}.log"
}

# Check if an instance is running
is_running() {
    local instance="$1"
    local pid_file=$(get_pid_file_path "$instance")
    
    if [[ -f "$pid_file" ]]; then
        local pid=$(cat "$pid_file")
        if ps -p "$pid" > /dev/null; then
            return 0 # Running
        else
            # PID file exists, but process doesn't. Clean up.
            log_warning "检测到陈旧的PID文件 ${pid_file}。正在移除。"
            rm -f "$pid_file"
            return 1 # Not running
        fi
    fi
    return 1 # Not running
}

start_instance() {
    local instance="$1"
    local config_file="${CONFIG_DIR}/${instance}.json"
    local pid_file=$(get_pid_file_path "$instance")
    local log_file=$(get_log_file_path "$instance")

    if [[ -z "$instance" ]]; then
        log_error "请提供一个服务实例名称 (例如: $0 start my-client)"
        exit 1
    fi

    if ! [[ -f "$INSTALL_PATH" ]]; then
        log_error "T2D二进制文件 ${INSTALL_PATH} 不存在。请先运行安装脚本。"
        exit 1
    fi

    if ! [[ -f "$config_file" ]]; then
        log_error "配置文件 ${config_file} 不存在。请创建或检查路径。"
        exit 1
    fi

    if is_running "$instance"; then
        log_warning "${SERVICE_NAME}@${instance} 已经在运行中。"
        return 0
    fi

    log_info "启动 ${SERVICE_NAME}@${instance}..."
    
    mkdir -p "$PID_DIR"
    mkdir -p "$LOG_DIR"
    
    # Run in background, redirect output, store PID
    nohup "$INSTALL_PATH" -config "$config_file" >> "$log_file" 2>&1 &
    echo $! > "$pid_file"
    
    sleep 1 # Give it a moment to start
    if is_running "$instance"; then
        log_success "${SERVICE_NAME}@${instance} 启动成功。日志: ${log_file}"
    else
        log_error "${SERVICE_NAME}@${instance} 启动失败。请检查日志: ${log_file}"
        exit 1
    fi
}

stop_instance() {
    local instance="$1"
    local pid_file=$(get_pid_file_path "$instance")

    if [[ -z "$instance" ]]; then
        log_error "请提供一个服务实例名称 (例如: $0 stop my-client)"
        exit 1
    fi

    if ! is_running "$instance"; then
        log_warning "${SERVICE_NAME}@${instance} 未在运行中。"
        return 0
    fi

    local pid=$(cat "$pid_file")
    log_info "停止 ${SERVICE_NAME}@${instance} (PID: ${pid})..."
    
    kill "$pid"
    sleep 1
    if ps -p "$pid" > /dev/null; then
        log_warning "正在强制终止 ${SERVICE_NAME}@${instance} (PID: ${pid})..."
        kill -9 "$pid"
        sleep 1
    fi

    if ! ps -p "$pid" > /dev/null; then
        rm -f "$pid_file"
        log_success "${SERVICE_NAME}@${instance} 停止成功。"
    else
        log_error "${SERVICE_NAME}@${instance} 停止失败。"
        exit 1
    fi
}

restart_instance() {
    local instance="$1"
    if [[ -z "$instance" ]]; then
        log_error "请提供一个服务实例名称 (例如: $0 restart my-client)"
        exit 1
    fi
    log_info "重启 ${SERVICE_NAME}@${instance}..."
    stop_instance "$instance"
    start_instance "$instance"
}

status_instance() {
    local instance="$1"
    if [[ -z "$instance" ]]; then
        log_error "请提供一个服务实例名称 (例如: $0 status my-client)"
        exit 1
    fi
    
    log_info "检查 ${SERVICE_NAME}@${instance} 状态..."
    if is_running "$instance"; then
        local pid=$(cat $(get_pid_file_path "$instance"))
        log_success "${SERVICE_NAME}@${instance} 正在运行 (PID: ${pid})."
        return 0
    else
        log_error "${SERVICE_NAME}@${instance} 未运行。"
        return 3 # LSB status code for not running
    fi
}

# Main logic
# Ensure we are root for operations that require it
if [[ $EUID -ne 0 ]]; then
    log_error "此脚本需要root权限运行。请使用: sudo $0"
    exit 1
fi

case "$1" in
    start)
        shift
        start_instance "$@"
        ;;
    stop)
        shift
        stop_instance "$@"
        ;;
    restart)
        shift
        restart_instance "$@"
        ;;
    status)
        shift
        status_instance "$@"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status} <instance_name>"
        echo "Example: $0 start my-client"
        exit 1
        ;;
esac

exit 0 