#!/bin/bash
# chkconfig: 2345 90 10
# description: T2D UDP-over-TCP Tunnel Manager

### BEGIN INIT INFO
# Provides:          t2d
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Manage T2D instances
# Description:       Start/Stop multiple T2D tunnel instances by name
### END INIT INFO

NAME="t2d"
BIN="/bin/t2d"
CONF_DIR="/etc/t2d"
PID_DIR="/var/run/t2d"
LOG_DIR="/var/log/t2d"

# 返回某实例的 PID 文件
get_pid_file() {
    echo "${PID_DIR}/${NAME}-$1.pid"
}

# 返回某实例的 LOG 文件
get_log_file() {
    echo "${LOG_DIR}/${NAME}-$1.log"
}

# 判断进程是否运行
is_running() {
    local pidfile=$(get_pid_file "$1")
    [[ -f "$pidfile" ]] || return 1
    local pid=$(cat "$pidfile")
    ps -p "$pid" > /dev/null 2>&1
}

start() {
    local inst="$1"
    [[ -z "$inst" ]] && echo "请指定实例名: $0 start <instance>" && exit 1

    local config="${CONF_DIR}/${inst}.json"
    local pidfile=$(get_pid_file "$inst")
    local logfile=$(get_log_file "$inst")

    [[ ! -f "$BIN" ]] && echo "$BIN 不存在" && exit 1
    [[ ! -f "$config" ]] && echo "$config 配置不存在" && exit 1

    if is_running "$inst"; then
        echo "$NAME@$inst 已运行 (PID: $(cat $pidfile))"
        exit 0
    fi

    echo "启动 $NAME@$inst ..."
    mkdir -p "$PID_DIR" "$LOG_DIR"

    nohup "$BIN" -config "$config" >> "$logfile" 2>&1 &
    echo $! > "$pidfile"
    sleep 1

    if is_running "$inst"; then
        echo "$NAME@$inst 启动成功 (PID: $(cat $pidfile))"
    else
        echo "$NAME@$inst 启动失败，请检查日志 $logfile"
        exit 1
    fi
}

stop() {
    local inst="$1"
    [[ -z "$inst" ]] && echo "请指定实例名: $0 stop <instance>" && exit 1

    local pidfile=$(get_pid_file "$inst")
    if ! is_running "$inst"; then
        echo "$NAME@$inst 未运行"
        return 0
    fi

    local pid=$(cat "$pidfile")
    echo "停止 $NAME@$inst (PID: $pid)"
    kill "$pid"
    sleep 1

    if ps -p "$pid" > /dev/null 2>&1; then
        echo "强制终止 $pid"
        kill -9 "$pid"
    fi

    rm -f "$pidfile"
    echo "$NAME@$inst 已停止"
}

status() {
    local inst="$1"
    [[ -z "$inst" ]] && echo "请指定实例名: $0 status <instance>" && exit 1

    if is_running "$inst"; then
        echo "$NAME@$inst 正在运行 (PID: $(cat $(get_pid_file $inst)))"
    else
        echo "$NAME@$inst 未运行"
    fi
}

restart() {
    local inst="$1"
    [[ -z "$inst" ]] && echo "请指定实例名: $0 restart <instance>" && exit 1
    stop "$inst"
    start "$inst"
}

case "$1" in
    start)   start "$2" ;;
    stop)    stop "$2" ;;
    status)  status "$2" ;;
    restart) restart "$2" ;;
    *)
        echo "用法: $0 {start|stop|restart|status} <instance>"
        exit 1
        ;;
esac

exit 0
